# Copy to .env and fill in with real values. Never commit .env.

PORT=3000

# From the GitHub App's settings page (or the manifest-flow conversion
# response — see app.yml's header comment).
GITHUB_APP_ID=
# PEM contents. If stored as a single env-var line, escape newlines as
# literal `\n` — server.js un-escapes them at startup. Prefer a real
# multi-line value (or a secrets manager) over this env var in production.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# From https://anakin.io/dashboard
ANAKIN_API_KEY=
ANAKIN_BASE_URL=https://api.anakin.io/v1
